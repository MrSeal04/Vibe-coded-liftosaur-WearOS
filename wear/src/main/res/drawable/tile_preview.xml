<?xml version="1.0" encoding="utf-8"?>
<!--
  Schematic of the Tile as it appears in the picker: title, the number, a supporting line
  and the edge button. Deliberately not a screenshot - a screenshot would show one
  particular exercise at one particular weight and would be stale the day it was taken.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="300dp"
    android:height="300dp"
    android:viewportWidth="300"
    android:viewportHeight="300">

    <path
        android:fillColor="#FF000000"
        android:pathData="M0,0 h300 v300 h-300 z" />

    <!-- title -->
    <path
        android:fillColor="#FF9E9E9E"
        android:pathData="M105,62 h90 a5,5 0 0 1 0,10 h-90 a5,5 0 0 1 0,-10 z" />

    <!-- the number -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M78,104 h144 a14,14 0 0 1 0,28 h-144 a14,14 0 0 1 0,-28 z" />

    <!-- supporting line -->
    <path
        android:fillColor="#FF9E9E9E"
        android:pathData="M96,156 h108 a6,6 0 0 1 0,12 h-108 a6,6 0 0 1 0,-12 z" />

    <!-- edge button -->
    <path
        android:fillColor="#FFD0BCFF"
        android:pathData="M70,206 h160 a34,34 0 0 1 -34,44 h-92 a34,34 0 0 1 -34,-44 z" />
</vector>
