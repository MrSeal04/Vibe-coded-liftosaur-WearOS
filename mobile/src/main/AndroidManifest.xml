<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".MobileApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LiftWear">

        <activity
            android:name=".PhoneActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.LiftWear">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Deletes the credential DataItem when the watch confirms receipt. Must be a service:
          the ack routinely arrives after the user has put the phone away.
        -->
        <!-- No android:permission - see the note on the watch's CredentialListenerService.
             Gated, this never bound, so the ack was never processed and the credential
             DataItem was only ever removed by the 90-second withdraw: the phone reported a
             failed hand-off even when the watch had the key. -->
        <service
            android:name=".AckListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:path="/liftwear/credentials/ack" />
            </intent-filter>
        </service>
    </application>
</manifest>
