<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".MobileApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LiftWear">

        <activity
            android:name=".PhoneActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.LiftWear">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Deletes the credential DataItem when the watch confirms receipt. Must be a service:
          the ack routinely arrives after the user has put the phone away.
        -->
        <!-- No android:permission - see the note on the watch's CredentialListenerService.
             Gated, this never bound, so the ack was never processed and the credential
             DataItem was only ever removed by the 90-second withdraw: the phone reported a
             failed hand-off even when the watch had the key. -->
        <service
            android:name=".AckListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:path="/liftwear/credentials/ack" />
            </intent-filter>
        </service>

        <!--
          Receives the watch's debug log over a Data Layer channel, keeps the latest copy and
          answers with the number of bytes saved. No android:permission, for the same reason as
          AckListenerService above.
        -->
        <service
            android:name=".WatchLogReceiverService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.CHANNEL_EVENT" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:path="/liftwear/debug-log" />
            </intent-filter>
        </service>

        <!-- Lets the share sheet hand the received log to another app, and nothing else. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.watchlog"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/watch_log_paths" />
        </provider>
    </application>
</manifest>
