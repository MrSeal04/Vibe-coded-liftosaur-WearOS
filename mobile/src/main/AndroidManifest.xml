<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".MobileApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LiftWear">

        <activity
            android:name=".PhoneActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.LiftWear">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Deletes the credential DataItem when the watch confirms receipt. Must be a service:
          the ack routinely arrives after the user has put the phone away.
        -->
        <service
            android:name=".AckListenerService"
            android:exported="true"
            android:permission="com.google.android.gms.permission.BIND_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:path="/liftwear/credentials/ack" />
            </intent-filter>
        </service>
    </application>
</manifest>
